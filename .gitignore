# ===========================================
# AgendaEstética - GitIgnore Completo
# Reference: PLANO-MESTRE-TECNICO.md > Seção 0.1
# ===========================================

# -------------------------------------------
# SENSÍVEL - NUNCA COMMITAR
# -------------------------------------------
.env
.env.local
.env.*.local
.env.*.local.*
.env.production
.env.development
*.local
*.local.new
*.local.*

# Firebase
firebase-credentials.json
serviceAccountKey.json
*.local.json

# -------------------------------------------
# DEPENDÊNCIAS
# -------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------------------------
# BUILD E DISTRIBUIÇÃO
# -------------------------------------------
dist/
build/
.cache/
.parcel-cache/
.eslintcache
*.min.js
*.min.css

# -------------------------------------------
# IDE E EDITORES
# -------------------------------------------
.vscode/
.idea/
*.sublime-*
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project
.sequelpro/

# -------------------------------------------
# SISTEMA OPERACIONAL
# -------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.bak

# -------------------------------------------
# FIREBASE
# -------------------------------------------
.firebase/
.firebase-cache/
firestore-debug.log
firestore-emulator.log
ui-debug.log
.firebaserc
database.rules.json
storage.rules

# -------------------------------------------
# VERCEL
# -------------------------------------------
.vercel/
.vercelignore

# -------------------------------------------
# TESTES
# -------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
cypress/videos/
cypress/screenshots/
*.lcov

# -------------------------------------------
# BACKUPS E TEMPORÁRIOS
# -------------------------------------------
*.backup
*.tmp
*.temp
*~$
*#
.#*
__pycache__/
*.pyc
*.pyo

# -------------------------------------------
# ARQUIVOS DO PROJETO (se necessário)
# -------------------------------------------
# Descomente se quiser ignorar documentação local
# docs/local/
# notas/
# personal-notes/

# -------------------------------------------
# PUPPETEER E2E TESTS
# -------------------------------------------
.puppeteer/
chromium/
.chromium-profile/

# -------------------------------------------
# SERVIDOR LOCAL (DEV)
# -------------------------------------------
http-server.log
dev-server.pid
*.port

# -------------------------------------------
# LOCK FILES (opcional - incluir se trabalhar em equipe)
# -------------------------------------------
# Descomente se usar npm/yarn em equipe
# package-lock.json
# yarn.lock

# -------------------------------------------
# CERTIFICADOS LOCAIS
# -------------------------------------------
*.pem.local
*.key.local
*.crt.local
localhost.*

# -------------------------------------------
# SESSION E STORAGE LOCAIS
# -------------------------------------------
.session/
.cache/session/
*.session
user-data/

# -------------------------------------------
# -------------------------------------------
*.log
debug.log
*.pem
*.key
*.crt
.envrc
.vercel
.env*.local
